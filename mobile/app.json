{
  "expo": {
    "name": "JARVIS",
    "slug": "jarvis-ios",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "jarvis",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jarvis.assistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "JARVIS uses the microphone when you choose to speak.",
        "NSSpeechRecognitionUsageDescription": "JARVIS uses speech recognition to transcribe your request.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jarvis.assistant",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "JARVIS uses the microphone when you choose to speak.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "JARVIS uses the microphone when you choose to speak.",
          "speechRecognitionPermission": "JARVIS uses speech recognition to transcribe your request."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ee9d8b06-83c1-4073-a1a2-10562456e6fe"
      }
    }
  }
}
