# Copy this file to .env and fill it in. NEVER put real values in this file —
# .env is gitignored, .env.example is committed.

# ---- Database ----
# Neon: use the DIRECT (unpooled) connection string — no "-pooler" in the host.
# Prisma migrations need it. Railway Postgres sets this for you automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- OpenRouter ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Comma-separated fallback chain. Blank = the free chain in src/lib/models.ts.
# The model picker in the app writes to your profile and takes priority.
OPENROUTER_MODELS=""
# Cheap, fast model for background work (memory extraction, chat titles).
OPENROUTER_UTILITY_MODEL=""
# Your deployed URL once it's live — shows up on OpenRouter's rankings.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="JARVIS"

# ---- Voice (text to speech) ----
# Uses the OPENROUTER_API_KEY above — no separate provider account needed.
# Override the model only if OpenRouter retires this id.
TTS_MODEL="openai/gpt-4o-mini-tts"

# ---- Auth (single user) ----
# The password you type on the login screen.
APP_PASSWORD=""
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Model used for web searches (the search_web tool). Defaults to the first
# model in your chain. Search itself costs ~$0.007 per call on top of tokens.
OPENROUTER_SEARCH_MODEL=""

# ---- Proactive notifications (Web Push) ----
# Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Optional: lets an external scheduler call POST /api/agenda.
# Leave blank — the app runs its own hourly scheduler in-process.
CRON_SECRET=""
# Set to 1 to turn the in-process scheduler off (e.g. running >1 instance).
DISABLE_SCHEDULER=""

# ---- Personal ----
OWNER_NAME="Colin"
TZ="America/Chicago"
