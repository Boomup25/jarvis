# dependencies
node_modules/

# next.js
.next/
out/
build/
next-env.d.ts

# env — never commit real credentials
.env
.env*.local

# keys and certificates — never, under any circumstances
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
*_rsa
*_ed25519
.ssh/

# personal scratch notes (these tend to collect connection strings)
Jarvis docs.txt
notes.txt
scratch/

# IDE / editor state
# .vs holds locked index files that break Tailwind's source scanning
.vs/
.idea/
*.suo
*.user
*.sln.docstates

# misc
desktop/dist/
desktop/*.exe
desktop/*.blockmap
*.tsbuildinfo
.DS_Store
Thumbs.db
.vercel
prisma/dev.db*
